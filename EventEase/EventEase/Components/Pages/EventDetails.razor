@page "/event-details/{eventId:int?}"
@inject NavigationManager Navigation
@inject EventEase.Services.AttendanceService Attendance
@attribute [StreamRendering]

<PageTitle>Event Details</PageTitle>

@if (eventDetails == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="event-details">
        <h1>@eventDetails.Name</h1>
        <p>Date: @eventDetails.Date.ToString("dd MMM yyyy")</p>
        <p>Location: @eventDetails.Location</p>
        <p>Description: @eventDetails.Description</p>

        <h3>Attendees</h3>
        <ul>
            @foreach (var attendee in Attendance.GetAttendees(eventDetails.Id))
            {
                <li>@attendee</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter]
    public int? eventId { get; set; }

    private EventDetailsModel? eventDetails;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);   // Simulate asynchronous loading to demonstrate streaming rendering

        if (eventId == null)
        {
            eventId = Random.Shared.Next(1, 1000);
            Navigation.NavigateTo($"/event-details/{eventId}", true);   // Handle the case where EventId is not provided (e.g., redirect to a default page)
            return;
        }

        eventDetails = await FetchEventDetailsAsync(eventId.Value);        // Fetch event details based on the EventId
    }

    private async Task<EventDetailsModel?> FetchEventDetailsAsync(int eventId)
    {
        await Task.Delay(1000);
   // Simulate fetching event details from a data source
        return new EventDetailsModel
        {
            Id = eventId,
            Name = $"Sample Event - {eventId}",
            Date = DateTime.Now.AddDays(7),
            Location = "Sample Location",
            Description = "This is a sample event description."
        };
    }

    
}