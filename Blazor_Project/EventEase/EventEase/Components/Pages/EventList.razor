@page "/event-list"
@using EventEase.Components.Shared
@using EventEase.Shared.Models
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject NavigationManager NavigationManager

<PageTitle>Event List</PageTitle>

<h1>Event List</h1>

<p>Here are some upcoming events:</p>

@if (eventsList == null) 
{
    <p><em>Loading...</em></p>
}
else
{
    <div style="height:65rem;overflow-y:scroll">
        <Virtualize Items="eventsList" Context="eventM" ItemSize="100" OverscanCount="2">
            <EventCard eventModel="eventM" />
        </Virtualize>
    </div>
}

@code {
    private List<EventModel>? eventsList; // Simulated data source

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        await Task.Delay(500);

        // Fetch event list (simulated)
        eventsList = await FetchEventListAsync();

        Console.WriteLine($"Event list initialized with {eventsList?.Count ?? 0} events.");
    }

    private async Task<List<EventModel>> FetchEventListAsync()
    {
        // Simulate fetching event list from a data source
        await Task.Delay(1000); // Simulate network delay

        return new List<EventModel>
        {
            new EventModel(1, "Sample Event 1", DateTime.Now.AddDays(7), "Location 1", "Description 1"),
            new EventModel(2, "Sample Event 2", DateTime.Now.AddDays(14), "Location 2"),
            new EventModel(3, "Sample Event 3", DateTime.Now.AddDays(21), "Location 3", "Description 3"),
            // Add more events as needed for testing
        };
    }
}
