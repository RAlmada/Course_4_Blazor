@page "/event-registration/{eventId:int?}"
@inject IJSRuntime JSRuntime
@inject EventEase.Services.UserSessionService UserSessionService
@inject EventEase.Services.AttendanceService AttendanceService

@if (eventId == null)
{
    <p><em>Invalid event ID.</em></p>
}
else if (isRegistered)
{
    <p class="text-success" style="margin: 1rem 0;">Thank you for registering, @registrationModel.Name!</p>
}
else if (hasAlreadyRegistered)
{
    <p class="text-warning">You have already registered for this event.</p>
}
else
{
    <h1>Event Registration</h1>
    <p>Register for Event ID: @eventId</p>

    <EditForm Model="registrationModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-field">
            <label for="name">Name:</label>
            <InputText id="name" @bind-Value="registrationModel.Name" class="form-control" />
            <ValidationMessage For="@(() => registrationModel.Name)" />
        </div>

        <div class="form-field">
            <label for="email">Email:</label>
            <InputText id="email" @bind-Value="registrationModel.Email" class="form-control" />
            <ValidationMessage For="@(() => registrationModel.Email)" />
        </div>

        <div class="form-field">
            <label for="phone">Phone Number:</label>
            <InputText id="phone" @bind-Value="registrationModel.PhoneNumber" class="form-control" />
            <ValidationMessage For="@(() => registrationModel.PhoneNumber)" />
        </div>

        <button type="submit" class="btn btn-primary form-submit-btn" id="registration-submit-btn">Register</button>
    </EditForm>
}

@code {
    [Parameter]
    public int? eventId { get; set; }

    private RegistrationModel registrationModel = new RegistrationModel();
    private bool isRegistered = false;
    private bool hasAlreadyRegistered = false;

    protected override void OnParametersSet()
    {
        if (eventId == null)
        {
            registrationModel = new RegistrationModel();
        }
        else
        {
            registrationModel = new RegistrationModel(DateTime.Now, eventId.HasValue ? eventId.Value : 0);
        }

        // Auto-fill the user's name if logged in
        if (!string.IsNullOrEmpty(UserSessionService.UserName))
        {
            registrationModel.Name = UserSessionService.UserName;
        }

        // Check if the user has already registered for this event
        if (eventId.HasValue && UserSessionService.GetData<HashSet<int>>("RegisteredEvents")?.Contains(eventId.Value) == true)
        {
            hasAlreadyRegistered = true;
        }
    }

    private void HandleValidSubmit()
    {
        isRegistered = true;

        Console.WriteLine($"Registration successful for Event Id: {eventId}. Name: {registrationModel.Name}, Email: {registrationModel.Email}, Phone: {registrationModel.PhoneNumber}");

        // Update user session data to track that the user has signed up for this event
        var registeredEvents = UserSessionService.GetData<HashSet<int>>("RegisteredEvents") ?? new HashSet<int>();
        if (eventId.HasValue) registeredEvents.Add(eventId.Value);
        UserSessionService.SetData("RegisteredEvents", registeredEvents);

        // Mark attendance for the event
        if (eventId.HasValue) AttendanceService.MarkAttendance(eventId.Value, registrationModel.Name);
    }
}
