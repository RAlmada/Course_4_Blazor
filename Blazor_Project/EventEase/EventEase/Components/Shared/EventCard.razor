@using EventEase.Shared.Models
@rendermode InteractiveServer
@inject NavigationManager Navigation

@if (eventModel == null)
{
    <p><em>Invalid event data.</em></p>
}
else
{
    <div class="event-card">
        <h3>@eventModel.Name</h3>
        <p>Date: @eventModel.Date.ToString("dd MMM yyyy")</p>
        <p>Location: @eventModel.Location</p>
        <span>
            <button class="btn btn-primary" @onclick="NavigateToEventDetails">View Details</button>
            <button class="btn btn-secondary" @onclick="NavigateToEventRegistration">Register</button>
        </span>
    </div>
}

@code {
    [Parameter]
    public EventModel? eventModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (eventModel == null)
        {
            Console.WriteLine("EventModel is null. Cannot initialize.");
            return;
        }

        // Simulate asynchronous loading to demonstrate streaming rendering
        await Task.Delay(500);
        Console.WriteLine($"EventCard initialized for Event ID: {eventModel.Id}");
    }

    private void NavigateToEventDetails()
    {
        if (eventModel == null)
        {
            Console.WriteLine("EventModel is null. Cannot navigate to event details.");
            return;
        }

        Console.WriteLine($"Navigating to event details for Event ID: {eventModel.Id}");
        Navigation.NavigateTo($"event-details/{eventModel.Id}", true);
    }

    private void NavigateToEventRegistration()
    {
        if (eventModel == null)
        {
            Console.WriteLine("EventModel is null. Cannot navigate to event registration.");
            return;
        }

        Console.WriteLine($"Navigating to event registration for Event ID: {eventModel.Id}");
        Navigation.NavigateTo($"event-registration/{eventModel.Id}", true);
    }
}
