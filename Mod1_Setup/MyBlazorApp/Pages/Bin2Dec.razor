@page "/Bin2Dec"

<PageTitle>Bin 2 Dec</PageTitle>

<h1>Binary to Decimal</h1>

<div style="padding: 20px 0px">
    <input type="text" id="userInput" @oninput="UpdateUserInput" maxlength="8" pattern="[01]+" />
    <span style="padding: 0px 5px">--></span>
    <input type="text" id="output" disabled value="@calculatedDecimal" />
</div>
<div>
    <input type="checkbox" id="isBigEndian" @onchange="ToggleIsBigEndian" checked="@isBigEndian" /> Big Endian
</div>

@code {
    private int? calculatedDecimal = null;
    bool isBigEndian = true;
    string userInput = string.Empty;

    private void ToggleIsBigEndian(ChangeEventArgs e)
    {
        isBigEndian = (e.Value as bool?) ?? false;
        CalculateDecimal();
    }

    private void UpdateUserInput(ChangeEventArgs e)
    {
        userInput = (e.Value as string)?.Trim() ?? string.Empty;
        CalculateDecimal();
    }

    private void CalculateDecimal()
    {
        if (string.IsNullOrEmpty(userInput))
        {
            calculatedDecimal = null;
            return;
        }

        string binaryInput = isBigEndian ? userInput : new string(userInput.Reverse().ToArray());
        calculatedDecimal = Convert.ToInt32(binaryInput, 2);
    }
}
